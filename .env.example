# ==============================================================================
# NeuronDash Project Environment Variables Configuration (Example)
# Copy this file to '.env' or respective subfolders and configure the settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Place in server/.env or configure as system env vars)
# ------------------------------------------------------------------------------
PROJECT_NAME="NeuronDash AI"
API_V1_STR="/api/v1"
SECRET_KEY="SUPER_SECRET_NEURAL_TOKEN_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to local SQLite 'sqlite:///./neurondash.db' if empty)
DATABASE_URL=
# PostgreSQL options (used if DATABASE_URL is not set):
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neurondash

# File Storage Configuration
UPLOAD_DIR="uploads"
CLEANED_DIR="cleaned"

# Large Language Model (LLM) Integration API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration (Place in client/.env.local or configure as system env vars)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VERCEL_URL=
